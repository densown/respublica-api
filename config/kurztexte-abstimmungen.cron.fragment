# Taeglich 06:40 UTC: Kurztext (zwei Saetze DE/EN) fuer Abstimmungen ohne aktuellen Text.
# Laeuft nach fetch_abstimmungen.py (06:10) und fetch_votes.py (06:12), vor dem Brain-Briefing (07:00).
# Schreibt mit der Claude-CLI im Max-Plan, hoechstens 20 Abstimmungen und 4 Aufrufe je Lauf.
# PATH, damit cron die CLI findet (Installation unter /root/.local/bin oder /usr/local/bin).
# Installation: Kopie nach /etc/cron.d/kurztexte-abstimmungen und systemctl restart cron
PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
40 6 * * * root cd /root/apps/gesetze && .venv/bin/python3 scripts/kurztexte_abstimmungen.py >> /root/apps/gesetze/logs/cron.log 2>&1
